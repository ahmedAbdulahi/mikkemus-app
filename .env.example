# Connection string til Scaleway Managed Database for PostgreSQL.
# Finn denne i Scaleway-konsollen under Database Instances -> din instans -> "Connection details",
# eller via CLI: scw rdb instance get <instance-id>
#
# Format: postgresql://<bruker>:<passord>@<host>:<port>/<database>?sslmode=require
DATABASE_URL="postgresql://user:password@host.rdb.fr-par.scw.cloud:5432/mikkemus?sslmode=require"

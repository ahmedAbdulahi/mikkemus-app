# Connection string til Scaleway Managed Database for PostgreSQL.
# Finn denne i Scaleway-konsollen under Database Instances -> din instans -> "Connection details",
# eller via CLI: scw rdb instance get <instance-id>
#
# Format: postgresql://<bruker>:<passord>@<host>:<port>/<database>?sslmode=require
DATABASE_URL="postgresql://user:password@host.rdb.fr-par.scw.cloud:5432/mikkemus?sslmode=require"

# ---- Valgfritt: ressurser som testes på /status ----
# Appen starter og fungerer uten disse; /status viser bare hva som er satt
# opp og om det virker.

# Blob storage (S3-kompatibel, f.eks. Scaleway Object Storage).
# Bøttenavnet kan stå i stien til URL-en eller i BLOB_STORAGE_BUCKET, og
# brukernavn/passord kan alternativt ligge i URL-en: https://bruker:passord@vert/bøtte
# BLOB_STORAGE_URL="https://s3.fr-par.scw.cloud/mikkemus"
# BLOB_STORAGE_USERNAME="SCW..."   # access key
# BLOB_STORAGE_PASSWORD="..."      # secret key
# BLOB_STORAGE_BUCKET=""           # valgfri hvis bøtta står i URL-en
# BLOB_STORAGE_REGION=""           # valgfri, leses ellers fra vertsnavnet (s3.<region>.…)

# Block storage: stien der volumet er montert inn i containeren.
# BLOCK_STORAGE_PATH="/data"
